---
import data from '../data/consumption.json';

const allNights = [...data.nights].sort((a, b) => a.date.localeCompare(b.date));
const frDate = (ymd) => ymd.split('-').reverse().join('-');

// Moyenne glissante sur 7 nuits (en Wh), calculée sur l'historique complet
// pour que le début de la fenêtre affichée reste exact.
const allWh = allNights.map((n) => n.wh);
const allRoll = allWh.map((_, i) => {
  const win = allWh.slice(Math.max(0, i - 6), i + 1);
  return Math.round((win.reduce((a, b) => a + b, 0) / win.length) * 10) / 10;
});

// Affichage limité à l'année glissante ; le JSON conserve tout l'historique.
const WINDOW = 365;
const nights = allNights.slice(-WINDOW);
const dates = nights.map((n) => frDate(n.date));
const wh = nights.map((n) => n.wh);
const cov = nights.map((n) => n.coverage);
const hourly = nights.map((n) => n.hourlyWh);
const roll = allRoll.slice(-nights.length);

const totalKwh = wh.reduce((a, b) => a + b, 0) / 1000;
const avgKwh = totalKwh / (wh.length || 1);
const maxI = wh.indexOf(Math.max(...wh));
const minI = wh.indexOf(Math.min(...wh));
const fmt = (v, d = 1) => v.toLocaleString('fr-FR', { minimumFractionDigits: d, maximumFractionDigits: d });

const updated = data.updatedAt
  ? new Date(data.updatedAt).toLocaleString('fr-FR', { timeZone: data.timezone, dateStyle: 'short', timeStyle: 'short' })
  : '—';
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href={import.meta.env.BASE_URL.replace(/\/?$/, "/") + "favicon.svg"} type="image/svg+xml">
<title>Consommation nocturne — Enphase</title>
<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style is:global>
  :root { --bg:#0d1117; --card:#161b22; --border:#30363d; --txt:#e6edf3; --mut:#8b949e; --night:#1f6feb; --line:#f0883e; --cost:#3fb950; }
  * { box-sizing:border-box; margin:0; padding:0; }
  body { background:var(--bg); color:var(--txt); font-family:'Segoe UI',system-ui,sans-serif; padding:24px; max-width:1200px; margin:0 auto; }
  h1 { font-size:22px; font-weight:600; }
  .sub { color:var(--mut); font-size:13px; margin-top:4px; }
  .pricebar { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin:16px 0 4px; background:var(--card); border:1px solid var(--border); border-radius:10px; padding:12px 16px; }
  .pricebar label { color:var(--mut); font-size:13px; }
  .pricebar input { background:var(--bg); border:1px solid var(--border); color:var(--txt); border-radius:6px; padding:7px 10px; width:110px; font-size:15px; }
  .pricebar button { background:var(--cost); color:#04150a; border:none; border-radius:6px; padding:8px 14px; font-weight:700; font-size:13px; cursor:pointer; }
  .pricebar button:hover { filter:brightness(1.1); }
  .pricebar .cur { color:var(--mut); font-size:12px; margin-left:auto; }
  .kpis { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:12px; margin:14px 0; }
  .kpis-wrap { display:block; }
  @media (max-width: 900px) {
    .kpis-wrap { display:grid; grid-template-columns:1fr 1fr; gap:12px; align-items:start; }
    .kpis { margin:0; grid-template-columns:1fr; }
    .kpi { padding:10px 12px; }
    .kpi .v { font-size:19px; }
  }
  .kpis.cost .kpi { border-color:rgba(63,185,80,.35); }
  .kpi { background:var(--card); border:1px solid var(--border); border-radius:10px; padding:14px 16px; }
  .kpi .k { display:block; color:var(--mut); font-size:12px; text-transform:uppercase; letter-spacing:.5px; }
  .kpi .v { display:block; font-size:26px; font-weight:700; margin-top:4px; }
  .kpi small { font-size:13px; color:var(--mut); font-weight:400; }
  .kpi small.d { display:block; font-size:11px; }
  .kpi .v.c { color:var(--cost); }
  .card { background:var(--card); border:1px solid var(--border); border-radius:10px; padding:18px; margin-top:12px; }
  .legend { display:flex; gap:18px; color:var(--mut); font-size:12px; margin-bottom:10px; flex-wrap:wrap; }
  .legend i { display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:5px; }
  .foot { color:var(--mut); font-size:11px; margin-top:16px; text-align:center; }
  canvas { max-height:520px; }
  #chartjs-tooltip { position:fixed; pointer-events:none; opacity:0; z-index:1000;
    background:rgba(22,27,34,.97); border:1px solid var(--border); border-radius:10px;
    padding:10px 12px; font-size:12px; box-shadow:0 8px 24px rgba(0,0,0,.5); min-width:240px;
    transition:opacity .12s; }
  #chartjs-tooltip .tt-title { font-weight:700; font-size:13px; margin-bottom:2px; }
  #chartjs-tooltip .tt-sub { color:var(--mut); font-size:11px; margin-bottom:8px; }
  #chartjs-tooltip .tt-chart { width:270px; height:110px; margin-top:6px; }
</style>
</head>
<body>
  <h1>🌙 Consommation nocturne — 19h → 7h</h1>
  <div class="sub">Système Enphase {data.systemId} · {dates[0]} → {dates.at(-1)} · granularité horaire · fuseau {data.timezone}</div>
  <div class="pricebar">
    <label for="price">Prix du kWh (€)</label>
    <input id="price" type="number" step="0.001" min="0" value="0.15">
    <button id="apply">Mettre à jour les coûts</button>
    <span class="cur" id="curPrice"></span>
  </div>
  <div class="kpis-wrap">
    <div class="kpis">
      <div class="kpi"><span class="k">Total 19h→7h</span><span class="v">{fmt(totalKwh)} <small>kWh</small></span></div>
      <div class="kpi"><span class="k">Moyenne / nuit</span><span class="v">{fmt(avgKwh)} <small>kWh</small></span></div>
      <div class="kpi"><span class="k">Pire nuit</span><span class="v">{fmt(wh[maxI] / 1000)} <small>kWh</small><small class="d">{dates[maxI]}</small></span></div>
      <div class="kpi"><span class="k">Meilleure nuit</span><span class="v">{fmt(wh[minI] / 1000)} <small>kWh</small><small class="d">{dates[minI]}</small></span></div>
    </div>
    <div class="kpis cost" id="kpisCost">
      <div class="kpi"><span class="k">Coût total</span><span class="v c" id="cTotal">—</span></div>
      <div class="kpi"><span class="k">Coût moyen / nuit</span><span class="v c" id="cAvg">—</span></div>
      <div class="kpi"><span class="k">Pire nuit (coût)</span><span class="v c" id="cMax">—</span></div>
      <div class="kpi"><span class="k">Meilleure nuit (coût)</span><span class="v c" id="cMin">—</span></div>
    </div>
  </div>
  <div class="card">
    <div class="legend">
      <span><i style="background:var(--night)"></i>Énergie consommée pendant la nuit (kWh)</span>
      <span><i style="background:var(--line)"></i>Moyenne glissante 7 nuits</span>
      <span style="margin-left:auto">🖱️ Survole une barre → profil horaire de la nuit</span>
    </div>
    <canvas id="chart"></canvas>
  </div>
  <div class="foot">Source : Enphase API v4 (system_id {data.systemId}) · mis à jour le {updated} · généré automatiquement</div>
<script is:inline define:vars={{ dates, wh, roll, cov, hourly }}>
const kwh = wh.map(v => v / 1000);
const HOURS = ['19-20h','20-21h','21-22h','22-23h','23-0h','0-1h','1-2h','2-3h','3-4h','4-5h','5-6h','6-7h'];

const fmtKwh = v => v.toLocaleString('fr-FR', { maximumFractionDigits: 1 }) + ' kWh';
const fmtEur = v => v.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
const getPrice = () => parseFloat(localStorage.getItem('enphase_prix_kwh') || '0.2516');

function setPrice(p) {
  localStorage.setItem('enphase_prix_kwh', p);
  document.getElementById('curPrice').textContent = 'Prix appliqué : ' + p.toLocaleString('fr-FR', { maximumFractionDigits: 4 }) + ' €/kWh';
  const total = wh.reduce((a, b) => a + b, 0) / 1000 * p;
  const avg = total / wh.length;
  const maxI = wh.indexOf(Math.max(...wh));
  const minI = wh.indexOf(Math.min(...wh));
  document.getElementById('cTotal').textContent = fmtEur(total);
  document.getElementById('cAvg').textContent = fmtEur(avg);
  document.getElementById('cMax').innerHTML = fmtEur(wh[maxI] / 1000 * p) + ' <small class="d">' + dates[maxI] + '</small>';
  document.getElementById('cMin').innerHTML = fmtEur(wh[minI] / 1000 * p) + ' <small class="d">' + dates[minI] + '</small>';
}

document.getElementById('apply').addEventListener('click', () => {
  const p = parseFloat(document.getElementById('price').value);
  if (p >= 0) setPrice(p);
});
const saved = parseFloat(localStorage.getItem('enphase_prix_kwh'));
if (saved && saved >= 0) { document.getElementById('price').value = saved; setPrice(saved); }
else setPrice(parseFloat(document.getElementById('price').value));

const ctx = document.getElementById('chart');
const mainChart = new Chart(ctx, {
  type: 'bar',
  data: {
    labels: dates,
    datasets: [
      { label: 'kWh par nuit (19h→7h)', data: kwh,
        backgroundColor: kwh.map((v, i) => cov[i] < 0.9 ? 'rgba(139,148,158,.35)' : 'rgba(31,111,235,.75)'),
        borderWidth: 0, borderRadius: 2, order: 2 },
      { label: 'Moyenne glissante 7 nuits', data: roll.map(v => v / 1000), type: 'line',
        borderColor: 'rgba(240,136,62,1)', backgroundColor: 'rgba(240,136,62,.12)', fill: true,
        tension: .3, pointRadius: 0, borderWidth: 2, order: 1 },
    ]
  },
  options: {
    responsive: true,
    interaction: { mode: 'index', intersect: false },
    plugins: {
      tooltip: {
        enabled: false,
        external: function(context) {
          const tp = context.tooltip;
          let el = document.getElementById('chartjs-tooltip');
          if (!el) { el = document.createElement('div'); el.id = 'chartjs-tooltip'; document.body.appendChild(el); }
          if (tp.opacity === 0 || !tp.dataPoints || tp.dataPoints.length === 0) { el.style.opacity = 0; return; }
          const idx = tp.dataPoints[0].dataIndex;
          const v = wh[idx] / 1000;
          const p = getPrice();
          el.innerHTML =
            '<div class="tt-title">Nuit du ' + dates[idx] + '</div>' +
            '<div class="tt-sub">' + fmtKwh(v) + ' · ≈ ' + Math.round(wh[idx]/12) + ' W moyen · coût ' + fmtEur(v * p) +
            ' · couverture ' + Math.round(cov[idx]*100) + '%</div>' +
            '<div class="tt-chart"><canvas id="tt-canvas"></canvas></div>';
          el.style.opacity = 1;
          const mc = document.getElementById('tt-canvas');
          if (window.ttChart) window.ttChart.destroy();
          window.ttChart = new Chart(mc, {
            type: 'bar',
            data: {
              labels: HOURS,
              datasets: [{ data: hourly[idx], backgroundColor: 'rgba(63,185,80,.65)', borderRadius: 2, borderWidth: 0 }]
            },
            options: {
              responsive: true, maintainAspectRatio: false,
              plugins: { legend: { display: false }, tooltip: { enabled: false } },
              scales: {
                x: { ticks: { color: '#8b949e', font: { size: 8 }, autoSkip: false, maxRotation: 60, minRotation: 60 }, grid: { display: false } },
                y: { beginAtZero: true, ticks: { color: '#8b949e', font: { size: 9 }, callback: v => v.toLocaleString('fr-FR') }, grid: { color: 'rgba(48,54,61,.3)' } },
              },
            },
          });
          const pos = mainChart.canvas.getBoundingClientRect();
          let x = pos.left + tp.caretX + 14;
          let y = pos.top + tp.caretY + 8;
          const r = el.getBoundingClientRect();
          if (x + r.width > window.innerWidth - 8) x = pos.left + tp.caretX - r.width - 14;
          if (y + r.height > window.innerHeight - 8) y = window.innerHeight - r.height - 8;
          el.style.left = x + 'px'; el.style.top = y + 'px';
        }
      },
      legend: { display: false },
    },
    scales: {
      x: { ticks: { color: '#8b949e', maxTicksLimit: 13, maxRotation: 0, autoSkip: true }, grid: { display: false } },
      y: { beginAtZero: true, ticks: { color: '#8b949e', callback: v => v.toLocaleString('fr-FR', { maximumFractionDigits: 1 }) + ' kWh' }, grid: { color: 'rgba(48,54,61,.4)' } },
    },
  },
});
</script>
</body>
</html>
